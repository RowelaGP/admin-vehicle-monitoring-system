// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Employee {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  middleName  String?
  designation String
  department  String
  branch       String

  vehicles    Vehicle[]   // one employee can have vehicles
}

model Vehicle {
  id              String   @id @default(uuid())
  vehicleType     String   // car or motor
  plateNumber     String   @unique
  vin             String   @unique
  engineNumber    String
  yearModel       Int
  makeModel       String
  tplPolicyNumber String?
  issuanceCategory String
  moaDate          DateTime?

  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])

  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
}
